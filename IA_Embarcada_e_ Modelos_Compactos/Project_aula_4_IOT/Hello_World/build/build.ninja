#############################################
# Utility command for edit_cache

build esp-idf/hal/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/esp-idf/hal && /opt/esp/tools/cmake/4.0.3/bin/ccmake -S/workspace -B/workspace/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/hal/edit_cache: phony esp-idf/hal/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/hal/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/esp-idf/hal && /opt/esp/tools/cmake/4.0.3/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/hal/rebuild_cache: phony esp-idf/hal/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build esp-idf/hal/list_install_components: phony


#############################################
# Utility command for install

build esp-idf/hal/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/hal/all
  COMMAND = cd /workspace/build/esp-idf/hal && /opt/esp/tools/cmake/4.0.3/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/hal/install: phony esp-idf/hal/CMakeFiles/install.util


#############################################
# Utility command for install/local

build esp-idf/hal/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/hal/all
  COMMAND = cd /workspace/build/esp-idf/hal && /opt/esp/tools/cmake/4.0.3/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/hal/install/local: phony esp-idf/hal/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build esp-idf/hal/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/hal/all
  COMMAND = cd /workspace/build/esp-idf/hal && /opt/esp/tools/cmake/4.0.3/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/hal/install/strip: phony esp-idf/hal/CMakeFiles/install/strip.util

