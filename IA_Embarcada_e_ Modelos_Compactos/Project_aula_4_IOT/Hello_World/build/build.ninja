  COMMAND = cd /workspace/build/esp-idf/esp_stdio && /opt/esp/tools/cmake/4.0.3/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/esp_stdio/install: phony esp-idf/esp_stdio/CMakeFiles/install.util


#############################################
