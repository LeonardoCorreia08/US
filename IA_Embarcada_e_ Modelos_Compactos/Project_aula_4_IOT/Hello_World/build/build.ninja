  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/driver/install/local: phony esp-idf/driver/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build esp-idf/driver/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/driver/all
