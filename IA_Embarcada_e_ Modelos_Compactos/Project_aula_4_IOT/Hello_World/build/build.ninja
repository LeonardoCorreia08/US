build CMakeFiles/refresh-config | ${cmake_ninja_workdir}CMakeFiles/refresh-config: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /opt/esp/python_env/idf6.1_py3.12_env/bin/python /opt/esp/idf/tools/kconfig_new/prepare_kconfig_files.py --list-separator=semicolon --env-file /workspace/build/config.env && /opt/esp/python_env/idf6.1_py3.12_env/bin/python -m kconfgen --list-separator=semicolon --kconfig /opt/esp/idf/Kconfig --sdkconfig-rename /opt/esp/idf/sdkconfig.rename --config /workspace/sdkconfig --env IDF_MINIMAL_BUILD=y --env-file /workspace/build/config.env --env IDF_TARGET=esp32s3 --env IDF_TOOLCHAIN=gcc --env IDF_ENV_FPGA= --env IDF_INIT_VERSION=6.1.0 --output config /workspace/sdkconfig
