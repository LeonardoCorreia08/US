  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/esp_mm/install/local: phony esp-idf/esp_mm/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build esp-idf/esp_mm/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/esp_mm/all
