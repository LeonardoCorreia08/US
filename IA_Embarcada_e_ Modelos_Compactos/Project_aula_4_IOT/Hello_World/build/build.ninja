build esp-idf/xtensa/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/xtensa/all
  COMMAND = cd /workspace/build/esp-idf/xtensa && /opt/esp/tools/cmake/4.0.3/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/xtensa/install: phony esp-idf/xtensa/CMakeFiles/install.util


#############################################
# Utility command for install/local

build esp-idf/xtensa/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/xtensa/all
  COMMAND = cd /workspace/build/esp-idf/xtensa && /opt/esp/tools/cmake/4.0.3/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/xtensa/install/local: phony esp-idf/xtensa/CMakeFiles/install/local.util


#############################################
