build esp-idf/driver/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/driver/all
  COMMAND = cd /workspace/build/esp-idf/driver && /opt/esp/tools/cmake/4.0.3/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/driver/install: phony esp-idf/driver/CMakeFiles/install.util


#############################################
# Utility command for install/local

build esp-idf/driver/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/driver/all
